<idea-plugin>
  <id>dev.unionbreeze</id>
  <name>UnionBreeze</name>
  <vendor url="https://github.com/IvanKobtsev/UnionBreeze">Ivan Kobtsev</vendor>
  <description>Give TypeScript unions first-class IDE support through the UnionBreeze language server.</description>
  <depends>com.intellij.modules.ultimate</depends>
  <depends>com.intellij.modules.lsp</depends>
  <depends>JavaScript</depends>
  <extensions defaultExtensionNs="com.intellij">
    <platform.lsp.integrationProvider implementation="dev.unionbreeze.webstorm.UnionBreezeLspProvider"/>
    <gotoDeclarationHandler implementation="dev.unionbreeze.webstorm.UnionBreezeGotoDeclarationHandler"/>
    <documentationProvider implementation="dev.unionbreeze.webstorm.UnionDocumentationProvider" order="first"/>
    <platform.backend.documentation.targetProvider implementation="dev.unionbreeze.webstorm.UnionDocumentationTargetProvider" order="first"/>
    <renameHandler implementation="dev.unionbreeze.webstorm.UnionBreezeRenameHandler"/>
    <annotator language="TypeScript" implementationClass="dev.unionbreeze.webstorm.UnionBreezeAnnotator"/>
    <colorSettingsPage implementation="dev.unionbreeze.webstorm.UnionBreezeColorSettingsPage"/>
    <applicationConfigurable id="unionbreeze.settings" displayName="UnionBreeze" instance="dev.unionbreeze.webstorm.UnionBreezeConfigurable"/>
    <intentionAction>
      <language>TypeScript</language>
      <className>dev.unionbreeze.webstorm.EnumToUnionIntention</className>
      <category>TypeScript</category>
    </intentionAction>
    <intentionAction>
      <language>TypeScript</language>
      <className>dev.unionbreeze.webstorm.ChangeUnionMemberIntention</className>
      <category>TypeScript</category>
    </intentionAction>
    <notificationGroup id="UnionBreeze" displayType="BALLOON"/>
  </extensions>
  <actions>
    <action id="dev.unionbreeze.webstorm.ChangeUnionMember" class="dev.unionbreeze.webstorm.ChangeUnionMemberAction" text="Change Union Member" description="Choose another contextual union member">
      <keyboard-shortcut keymap="$default" first-keystroke="alt shift U"/>
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
    </action>
  </actions>
</idea-plugin>
