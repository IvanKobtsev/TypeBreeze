<idea-plugin>
  <id>dev.typebreeze</id>
  <name>TypeBreeze</name>
  <vendor url="https://github.com/IvanKobtsev/TypeBreeze">Ivan Kobtsev</vendor>
  <description>Enhance TypeScript with union tools and compiler-backed extension-method suggestions from .ext.ts and .ext.tsx files.</description>
  <depends>com.intellij.modules.ultimate</depends>
  <depends>com.intellij.modules.lsp</depends>
  <depends>JavaScript</depends>
  <extensions defaultExtensionNs="com.intellij">
    <completion.contributor language="TypeScript" implementationClass="dev.typebreeze.webstorm.ExtensionCompletionContributor" order="first"/>
    <typedHandler implementation="dev.typebreeze.webstorm.ExtensionAutoPopup"/>
    <platform.lsp.integrationProvider implementation="dev.typebreeze.webstorm.TypeBreezeLspProvider"/>
    <gotoDeclarationHandler implementation="dev.typebreeze.webstorm.TypeBreezeGotoDeclarationHandler"/>
    <documentationProvider implementation="dev.typebreeze.webstorm.UnionDocumentationProvider" order="first"/>
    <platform.backend.documentation.targetProvider implementation="dev.typebreeze.webstorm.UnionDocumentationTargetProvider" order="first"/>
    <renameHandler implementation="dev.typebreeze.webstorm.TypeBreezeRenameHandler"/>
    <annotator language="TypeScript" implementationClass="dev.typebreeze.webstorm.TypeBreezeAnnotator"/>
    <annotator language="TypeScript" implementationClass="dev.typebreeze.webstorm.ExtensionMethodAnnotator"/>
    <colorSettingsPage implementation="dev.typebreeze.webstorm.TypeBreezeColorSettingsPage"/>
    <applicationConfigurable id="typebreeze.settings" displayName="TypeBreeze" instance="dev.typebreeze.webstorm.TypeBreezeConfigurable"/>
    <intentionAction>
      <language>TypeScript</language>
      <className>dev.typebreeze.webstorm.EnumToUnionIntention</className>
      <category>TypeScript</category>
    </intentionAction>
    <intentionAction>
      <language>TypeScript</language>
      <className>dev.typebreeze.webstorm.ChangeUnionMemberIntention</className>
      <category>TypeScript</category>
    </intentionAction>
    <notificationGroup id="TypeBreeze" displayType="BALLOON"/>
  </extensions>
  <actions>
    <action id="dev.typebreeze.webstorm.ChangeUnionMember" class="dev.typebreeze.webstorm.ChangeUnionMemberAction" text="Change Union Member" description="Choose another contextual union member">
      <keyboard-shortcut keymap="$default" first-keystroke="alt shift U"/>
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
    </action>
  </actions>
</idea-plugin>
